# Copy this file to `.env` and fill in your key. Then run `yarn dev`.
# These are read by the Node backend (server/index.mjs) and the CLI generator.

# The API key oMLX requires for requests. Find it in oMLX under
# General → Security (you can also turn the key requirement off there).
# The key stays server-side — it is never sent to the browser.
LLM_API_KEY=omlx-f04g11bl14kxkydo

# The local OpenAI-compatible endpoint (oMLX default shown).
LLM_BASE_URL=http://127.0.0.1:8000/v1

# Optional: pin a model id. Empty = use the first model the server reports.
LLM_MODEL=gemma-4-e2b-it-4bit

# Optional: port for the VG Generator backend (must match the Vite proxy).
PORT=8787

# --- Text-to-speech (Piper) -------------------------------------------------
# Start the voice with:  docker compose up -d piper
# TTS_ENABLED=false turns the "Hør saken" button off (backend returns 503).
TTS_ENABLED=true
TTS_HOST=127.0.0.1
TTS_PORT=10200
# Must match the --voice in docker-compose.yml.
TTS_VOICE=no_NO-talesyntese-medium
