{
  "name": "vggenerator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "server": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "seed": "node scripts/seed.mjs",
    "generate": "node scripts/generate.mjs",
    "electron:dev": "electron electron/main.dev.mjs",
    "electron:start": "electron electron/main.mjs",
    "vendor:llama": "node scripts/vendor-llama.mjs",
    "electron:pack": "electron-builder --dir --mac",
    "electron:build": "yarn build && node scripts/vendor-llama.mjs && electron-builder --mac"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "packageManager": "yarn@4.17.1"
}
